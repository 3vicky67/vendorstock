managed implementation in class zbp_i_rap_customer unique;
strict ( 2 );
with draft;

define behavior for ZI_RAP_CUSTOMER alias Customer
persistent table zrap_customer
draft table zrap_cust_d
lock master total etag LocalLastChangedAt // <-- Define ETag here
authorization master ( instance )
{
  create;
  update;
  delete;

  field ( readonly ) LocalLastChangedAt; // <-- Framework manages this

  draft determine action Prepare;
  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;

  mapping for zrap_customer
  {
    CustId = cust_id;
    Name = name;
    Email = email;
    Phone = phone;
    City = city;
    Country = country;
    LocalLastChangedAt = local_last_changed_at; // <-- Map the field
  }
}