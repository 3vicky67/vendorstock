@Metadata.layer: #CORE
@UI: { 
  headerInfo: { 
    typeName: 'Order Item', 
    typeNamePlural: 'Order Items', 
    title: { type: #STANDARD, value: 'ProdId' } 
  } 
}
annotate view ZC_RAP_ORD_ITEM with 
{
  @UI.facet: [ 
    { 
      id: 'Item', 
      purpose: #STANDARD, 
      type: #IDENTIFICATION_REFERENCE, 
      label: 'Item Details', 
      position: 10 
    } 
  ]

  @UI.hidden: true
  ItemUuid;
  
  @UI.hidden: true
  OrderUuid;

  @UI: { 
    lineItem:       [ { position: 10, label: 'Product ID' } ], 
    identification: [ { position: 10, label: 'Product ID' } ] 
  }
  ProdId;
  @UI: { 
    lineItem:       [ { position: 20, label: 'Quantity' } ], 
    identification: [ { position: 20, label: 'Quantity' } ] 
  }
  Quantity;
}