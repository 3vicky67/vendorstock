@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Customer',
    typeNamePlural: 'Customers',
    title: { type: #STANDARD, value: 'CustId' },
    description: { type: #STANDARD, value: 'Name' }
  }
}
annotate view ZC_RAP_CUSTOMER with
{
  @UI.facet: [
    {
      id: 'CustomerDetail',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Customer Details',
      position: 10
    }
  ]

  @UI.lineItem: [ { position: 10, label: 'Customer ID' } ]
  @UI.identification: [ { position: 10, label: 'Customer ID' } ]
  @UI.selectionField: [ { position: 10 } ]
  CustId;

  @UI.lineItem: [ { position: 20, label: 'Name' } ]
  @UI.identification: [ { position: 20, label: 'Name' } ]
  @UI.selectionField: [ { position: 20 } ]
  Name;

  @UI.lineItem: [ { position: 30, label: 'Email' } ]
  @UI.identification: [ { position: 30, label: 'Email' } ]
  Email;

  @UI.lineItem: [ { position: 40, label: 'Phone' } ]
  @UI.identification: [ { position: 40, label: 'Phone' } ]
  Phone;

  @UI.lineItem: [ { position: 50, label: 'City' } ]
  @UI.identification: [ { position: 50, label: 'City' } ]
  City;

  @UI.lineItem: [ { position: 60, label: 'Country' } ]
  @UI.identification: [ { position: 60, label: 'Country' } ]
  Country;

  @UI.hidden: true
  LocalLastChangedAt;
}