projection;
strict ( 2 );
use draft;

define behavior for ZC_RAP_ORDER alias Order
{
  use create;
  use update;
  use delete;

  use association _Items { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for ZC_RAP_ORD_ITEM alias OrderItem
{
  use update;
  use delete;

  use association _Order { with draft; }
}